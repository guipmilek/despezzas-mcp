# Alternativa opcional às credenciais abaixo. Token ID Firebase de uma sessão autenticada.
DESPEZZAS_TOKEN=

# Recomendado para um fork no Horizon. Cadastre estes valores como secrets do servidor.
DESPEZZAS_EMAIL=
DESPEZZAS_PASSWORD=

# Chave pública do Firebase Web usada pelo frontend do Despezzas.
DESPEZZAS_FIREBASE_API_KEY=

# Opcional. O padrão é https://api.despezzas.com.
DESPEZZAS_API_BASE_URL=https://api.despezzas.com
